<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">


<modelVersion>4.0.0</modelVersion>
   <groupId>org.picocontainer</groupId>
   <artifactId>picocontainer-root</artifactId>
   <name>PicoContainer Root</name>
   <version>2.16.1-SNAPSHOT</version>
   <packaging>pom</packaging>
   <url>https://www.picocontainer.com</url>

   <modules>
	<module>pico</module>
   </modules>
   <inceptionYear>2003</inceptionYear>
   <description>A small Java embeddable Dependency Injection container</description>
   <scm>
      <connection>scm:git:git://github.com/picocontainer/PicoContainer2.git</connection>
      <developerConnection>scm:git:git@github.com:picocontainer/PicoContainer2.git</developerConnection>
      <url>https://github.com/picocontainer/PicoContainer2</url>
      <tag>HEAD</tag>
   </scm>



   <licenses>
      <license>
         <name>BSD-3-Clause</name>
         <url>https://github.com/picocontainer/PicoContainer2/blob/master/pico/LICENSE.txt</url>
      </license>
   </licenses>

   <build>
      <plugins>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-release-plugin</artifactId>
            <version>3.1.1</version>
         </plugin>
         <!-- Publishes to Central Portal (central.sonatype.com); OSSRH was retired 2025-06-30.
              Needs a <server><id>central</id></server> in settings.xml holding a Portal user token. -->
         <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
               <publishingServerId>central</publishingServerId>
            </configuration>
         </plugin>
      </plugins>
   </build>

   <profiles>
      <!-- GPG signing only when releasing/attaching; not during plain build/install -->
      <profile>
         <id>attach</id>
         <build>
            <plugins>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-gpg-plugin</artifactId>
                  <version>3.2.7</version>
                  <executions>
                     <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                           <goal>sign</goal>
                        </goals>
                        <configuration>
                           <!-- Take the passphrase from gpg-agent rather than a tty, so
                                releases work in CI and other non-interactive shells. -->
                           <gpgArguments>
                              <arg>--pinentry-mode</arg>
                              <arg>loopback</arg>
                           </gpgArguments>
                        </configuration>
                     </execution>
                  </executions>
               </plugin>
            </plugins>
         </build>
      </profile>
   </profiles>

   <developers>
      <developer>
         <id>devs</id>
         <name>Developers</name>
         <organization>PicoContainer</organization>
         <organizationUrl>https://github.com/picocontainer</organizationUrl>
         <roles>
            <role>developer</role>
         </roles>
      </developer>
   </developers>
</project>
